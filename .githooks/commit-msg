#!/bin/sh
#
# DSG-HRMS — commit-msg kancasi
#
# Amac: Commit mesajlarinin Conventional Commits bicimine uymasini saglamak.
# Bkz. CONTRIBUTING.md §4
#
# Kurulum:  git config core.hooksPath .githooks

MESSAGE_FILE="$1"
SUBJECT=$(head -n1 "$MESSAGE_FILE")

RED='\033[0;31m'
RESET='\033[0m'

# Birlestirme ve geri alma commit'leri muaf
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# <tur>(<kapsam>)!: <ozet>
PATTERN='^(feat|fix|docs|test|refactor|perf|build|ci|chore)(\([a-z0-9.-]+\))?!?: .+$'

if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
    printf "%b" "${RED}"
    echo "======================================================================"
    echo " Commit mesaji bicimi hatali."
    echo "======================================================================"
    printf "%b" "${RESET}"
    echo ""
    echo " Girilen : $SUBJECT"
    echo ""
    echo " Beklenen: <tur>(<kapsam>): <ozet>"
    echo ""
    echo " Turler  : feat fix docs test refactor perf build ci chore"
    echo " Ornek   : feat(kimlik): uyelik dogrulama kodu gonderimi"
    echo ""
    echo " Ayrinti : CONTRIBUTING.md §4"
    echo ""
    exit 1
fi

# Ozet satiri uzunlugu
LENGTH=$(printf '%s' "$SUBJECT" | wc -m | tr -d ' ')
if [ "$LENGTH" -gt 72 ]; then
    printf "%b" "${RED}"
    echo " Ozet satiri $LENGTH karakter; en fazla 72 olmali."
    printf "%b" "${RESET}"
    echo " Ayrintiyi govde bolumune yazin."
    exit 1
fi

exit 0
