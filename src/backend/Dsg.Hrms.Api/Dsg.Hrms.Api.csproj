<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API KATMANI
    HTTP uc noktalari, kimlik dogrulama, ara katmanlar, OpenAPI sozlesmesi.

    KURAL (ADR-0002): Api yalnizca Application'a bagimlidir.
    Infrastructure'a YALNIZCA bagimlilik kaydi (DI) icin, kompozisyon kokunde
    dokunulur. Bu kisit Dsg.Hrms.Architecture.Tests tarafindan denetlenir.
  -->

  <PropertyGroup>
    <UserSecretsId>dsg-hrms-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dsg.Hrms.Application\Dsg.Hrms.Application.csproj" />
    <ProjectReference Include="..\Dsg.Hrms.Infrastructure\Dsg.Hrms.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dsg.Hrms.Api.IntegrationTests" />
  </ItemGroup>

</Project>
