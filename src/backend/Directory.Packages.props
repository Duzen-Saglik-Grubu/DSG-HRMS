<Project>

  <!--
    DSG-HRMS - Merkezi paket surum yonetimi.

    KURAL: Surumler YALNIZCA bu dosyada tanimlanir. Proje dosyalarinda
    <PackageReference Include="..." Version="..." /> yazilmaz; yalnizca Include kullanilir.

    KURAL: Yeni paket eklenmeden once LISANSI kontrol edilir. Kosullu ticari
    lisansli paket (ciro esigine bagli, kullanici sayisina bagli vb.) EKLENMEZ.
    Bkz. ADR-0001 ve docs/mimari/paket-envanteri.md
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Veri erisimi">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case adlandirma donusumu - ADR-0004 §1 -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- LOGO Bordro (MSSQL) salt-okunur erisim - ADR-0003 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Uygulama katmani">
    <!-- Nesne esleme: kaynak ureteci, calisma zamani maliyeti yok - ADR-0001 (KR-005) -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Loglama ve gozlemlenebilirlik">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Derleme zamaninda OpenAPI belgesi uretimi - ADR-0010 §1 -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <!--
      Belge ureten arac (ApiDescription.Server) Microsoft.OpenApi 2.12 ile derlenmis;
      AspNetCore.OpenApi ise 2.7.5 getiriyor. Surum sabitlenmezse arac, uygulamanin
      eski surumunu yukleyip "manifest definition does not match" hatasi veriyor.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Dis sistem entegrasyonu">
    <!-- Yeniden deneme, zaman asimi, devre kesici - ADR-0012 §5 -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup Label="Raporlama">
    <!-- Excel: MIT - ADR-0014 (KR-026) -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <!-- PDF: MIT - ADR-0014 (KR-025). QuestPDF kosullu lisansli oldugu icin kullanilmaz. -->
    <PackageVersion Include="PdfSharp" Version="6.2.1" />
    <PackageVersion Include="PdfSharp.MigraDoc" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!--
      Iddia kutuphanesi: Shouldly (BSD-3-Clause).
      FluentAssertions 8.x KOSULLU TICARI LISANSA gectigi icin KULLANILMAZ;
      bu, KR-005 (AutoMapper) ve KR-025 (QuestPDF) ile ayni ilkedir.
    -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Mimari kurallarinin otomatik denetimi - ADR-0002 -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Gercek PostgreSQL ile entegrasyon testi - ADR-0011 §3 -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
