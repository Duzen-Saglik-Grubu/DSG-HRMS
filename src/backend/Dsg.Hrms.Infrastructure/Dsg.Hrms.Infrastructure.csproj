<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ALTYAPI KATMANI
    Application katmanindaki arayuzlerin uygulamalari: EF Core, LOGO erisimi,
    dosya saklama, SMS, e-posta.

    KURAL (ADR-0002): Application ve Domain'e bagimlidir; Api'ye bagimli OLAMAZ.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Dsg.Hrms.Application\Dsg.Hrms.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MailKit" />
    <!-- Dis aktarma: Excel ClosedXML, PDF SkiaSharp (ADR-0014, KR-131). -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="SixLabors.Fonts" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!--
      Gunluk yapilandirmasi ve maskeleme ilkesi bu katmandadir (ADR-0009 §1, §4).
      Api yalnizca "gunlugu baslat" der; nasil yazildigini bilmez.
    -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yaygin parola listesi (SYG-KMLK-045). Kaynak ve lisans: Identity/Passwords/README.md -->
    <EmbeddedResource Include="Identity/Passwords/common-passwords.txt.gz" LogicalName="Dsg.Hrms.Infrastructure.CommonPasswords" />
    <!-- PDF raporlarinin gomulu yazi tipi (ADR-0014 §1). Kaynak ve lisans: Reports/Fonts/README.md -->
    <EmbeddedResource Include="Reports/Fonts/NotoSans-Regular.ttf" LogicalName="Dsg.Hrms.Infrastructure.Fonts.Regular" />
    <EmbeddedResource Include="Reports/Fonts/NotoSans-Bold.ttf" LogicalName="Dsg.Hrms.Infrastructure.Fonts.Bold" />
  </ItemGroup>

</Project>
