# DSG-HRMS UAT yigini ortam degiskenleri
#
# KULLANIM: sunucuda "/opt/dsg-hrms/secrets/.env.uat" adiyla kopyalayin.
# Gercek dosya DEPOYA GIRMEZ ve KAYNAK AGACININ DISINDA durur: dagitim,
# "docker" dizinini silip yeniden olusturur (bkz. docker/deploy-uat.sh).
#
# UAT verisi, gercek veriden MASKELENMIS kopyadir (ADR-0011 §7); yine de
# gelistirme parolasindan FARKLI bir parola kullanilir.

POSTGRES_DB=dsg_hrms_uat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistirin
POSTGRES_PORT=5434

# Yalnizca port NUMARASI yazilir. "127.0.0.1:" oneki compose dosyasinda
# sabittir; API ve veritabani buradaki bir yazim hatasiyla disari acilamaz.
API_PORT=5299

# Web disari acilan TEK servistir.
WEB_PORT=8081

# TLS. Sertifika dizini bos oldugunda yigin duz HTTP ile calisir.
# Uretim/UAT: TLS_DIR=/opt/dsg-hrms/tls ve WEB_TLS_PORT=443
TLS_DIR=./tls-empty
WEB_TLS_PORT=8443

# Kabul testi yapilacak SURUM. "latest" KULLANILMAZ: kabul formu belirli bir
# surume yazilir (TEC.11).
API_IMAGE=dsg-hrms-api:uat
WEB_IMAGE=dsg-hrms-web:uat

# LOGO Bordro veritabani - SALT OKUNUR oturum (KR-003, KR-004).
# Oturum docker/logo/read-only-login.sql ile olusturulur. Bos birakilirsa
# personel senkronizasyonu devre disi kalir. Yazma yetkili bir oturum verilirse
# senkronizasyon bunu her calismadan once tespit eder ve REDDEDER.
# DEGER TEK TIRNAK ICINDE YAZILIR. Bu dosyanin iki okuyucusu vardir: Docker Compose
# dosyayi duz metin okur, dagitim betigi (deploy-uat.sh) ise KABUK KOMUTU olarak
# okur. Tirnaksiz degerde kabuk noktali virgullerde satiri boler ve 'User Id=...'
# kismini komut olarak calistirmaya kalkar (#79).
# Ornek: LOGO_CONNECTION_STRING='Server=<logo-sunucusu>;Database=BORDRO;User Id=hrms_logo_reader;Password=...;TrustServerCertificate=true;ApplicationIntent=ReadOnly'
LOGO_CONNECTION_STRING=

# Sir parametrelerin (SMTP ve NetGSM parolalari) sifreleme anahtari (SYG-KMLK-075).
# Uretmek icin: openssl rand -base64 32  (tek tirnak icinde yazilir)
# ANAHTAR KAYBOLURSA veritabanindaki sir parametreler cozulemez ve parametre
# ekranindan yeniden girilmeleri gerekir. Anahtar veritabani yedegiyle AYNI yerde
# saklanmaz: ikisi birlikte ele gecerse sirlar acilir.
PARAMETER_PROTECTION_KEY=

# Dogrulama kodu ozet anahtari (SYG-KMLK-025). Uretmek icin: openssl rand -base64 32
IDENTITY_CODE_HASH_KEY=
# Erisim jetonu imzalama anahtari (ZORUNLU). Uretmek icin: openssl rand -base64 32
IDENTITY_JWT_SIGNING_KEY=

# Ileti gonderim kipi (#85). UAT GERCEK LOGO VERISIYLE calisir: Send kipi gercek
# personele kod gonderir ve KULLANILMAZ. Kabul testleri icin AllowList ve yalnizca
# test yapan kisilerin kurumsal e-posta / 5XXXXXXXXX bicimli telefonlari (virgulle).
NOTIFICATIONS_DELIVERY_MODE=LogOnly
NOTIFICATIONS_ALLOWED_RECIPIENTS=

# SMTP ve NetGSM (PRM-ENT-01, 02, 04, 06). Tek tirnak icinde yazilir (#79).
# Ornek: SMTP_SERVER='mail.duzen.com.tr:587'
# Sunucu, sertifikasindaki adla yazilir: gonderici sertifikayi DOGRULAR ve ad
# uyusmazsa baglanmaz (runbook §10.5).
SMTP_SERVER=
SMTP_PASSWORD=
NETGSM_USER_CODE=
NETGSM_PASSWORD=
