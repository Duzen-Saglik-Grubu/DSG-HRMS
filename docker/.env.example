# DSG-HRMS gelistirme yigini ortam degiskenleri
#
# KULLANIM: Bu dosyayi ".env" adiyla kopyalayin ve degerleri doldurun.
#           ".env" DEPOYA GIRMEZ (.gitignore).
#
# Gercek sirlar bu dosyaya YAZILMAZ; burada yalnizca ornek degerler bulunur
# (ADR-0008 §3, KR-038).

# --- PostgreSQL ---
POSTGRES_DB=dsg_hrms
POSTGRES_USER=postgres
# Gelistirme makinesine ozgu bir deger uretin; ornekteki degeri kullanmayin.
POSTGRES_PASSWORD=degistirin
# Makinede kurulu PostgreSQL 5432'yi kullaniyorsa catismamak icin 5433.
POSTGRES_PORT=5433

# --- Uygulama portlari ---
API_PORT=5199
WEB_PORT=8080

# --- Gozlemlenebilirlik (istege bagli) ---
# Toplayici adresi bos birakilirsa izleme verisi uretilir ama gonderilmez.
OTLP_ENDPOINT=

# --- LOGO (istege bagli) ---
# Salt okunur LOGO oturumu. Bos birakilirsa personel senkronizasyonu devre disidir.
LOGO_CONNECTION_STRING=

# --- Parametre sifreleme anahtari (istege bagli) ---
# Sir parametreler (SMTP/NetGSM parolalari) veritabaninda bu anahtarla sifrelenir.
# Uretmek icin: openssl rand -base64 32
PARAMETER_PROTECTION_KEY=

# --- Dogrulama kodu ve ileti gonderimi (istege bagli) ---
# Kod ozet anahtari. Uretmek icin: openssl rand -base64 32
IDENTITY_CODE_HASH_KEY=
# Erisim jetonu imzalama anahtari (ZORUNLU). Uretmek icin: openssl rand -base64 32
IDENTITY_JWT_SIGNING_KEY=
# Ilk sistem yoneticilerinin kurumsal e-postalari, virgulle (SYG-KMLK-074). Bu adreslerle giris
# yapan hesaba Sistem Yoneticisi rolu bir kez atanir; listeden cikarmak atamayi geri almaz.
# Ornek: ACCESS_CONTROL_BOOTSTRAP_ADMINISTRATORS=ad.soyad@duzen.com.tr
ACCESS_CONTROL_BOOTSTRAP_ADMINISTRATORS=
# Davet e-postasindaki baglantinin adresi (SYG-KMLK-051). UAT: https://insankaynaklaritest.duzen.com.tr
IDENTITY_PUBLIC_BASE_URL=
# LogOnly | AllowList | Send. Gelistirmede yalnizca kendi adresinize gondermek icin
# AllowList ve NOTIFICATIONS_ALLOWED_RECIPIENTS kullanin.
NOTIFICATIONS_DELIVERY_MODE=LogOnly
NOTIFICATIONS_ALLOWED_RECIPIENTS=
SMTP_SERVER=
SMTP_PASSWORD=
NETGSM_USER_CODE=
NETGSM_PASSWORD=
