{
  "openapi": "3.1.1",
  "info": {
    "title": "DSG-HRMS API",
    "description": "Duzen Saglik Grubu Insan Kaynaklari Yonetim Sistemi API sozlesmesi. Bu belge otomatik uretilir; elle duzenlenmez.",
    "contact": {
      "name": "Duzen Saglik Grubu - Bilgi Islem"
    },
    "version": "v1"
  },
  "paths": {
    "/api/v1/identity/account/password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Parolayi degistirir. Mevcut parola istenir; degisiklikten sonra hesabin DIGER oturumlari\nkapanir, bu oturum acik kalir (SYG-KMLK-048).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Parola degisti.",
            "content": {
              "application/json": { }
            }
          },
          "400": {
            "description": "Mevcut parola hatali (`errors.currentPassword`) veya yeni parola kurallara uymuyor (`errors.newPassword`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Oturum kapali.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Cok fazla hatali deneme; e-posta gecici olarak kilitli.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/identity/password-resets": {
      "post": {
        "tags": [
